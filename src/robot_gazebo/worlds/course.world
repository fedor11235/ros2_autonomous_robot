<?xml version="1.0" ?>
<!--
  Navigation course: flat ground, a scattering of static obstacles between the
  start zone (green, near origin) and the goal zone (red, far corner), plus a
  georeference (<spherical_coordinates>) so the GPS sensor emits real lat/lon.
-->
<sdf version="1.6">
  <world name="course">

    <!-- Georeference used by the GPS sensor plugin (Googleplex, arbitrary) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.4225</latitude_deg>
      <longitude_deg>-122.0840</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ========================= Boundary walls (10 x 10 arena) ========================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ========================= Obstacles ========================= -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>1.0 0.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_cyl_1">
      <static>true</static>
      <pose>2.2 -1.3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_box_2">
      <static>true</static>
      <pose>2.6 1.6 0.4 0 0 0.6</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.5 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.5 0.8</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_cyl_2">
      <static>true</static>
      <pose>3.6 -0.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_box_3">
      <static>true</static>
      <pose>3.4 2.6 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 1.2 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 1.2 0.8</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ========================= Start / Goal zone markers (thin visual pads) ========================= -->
    <model name="start_zone">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.2 0.6</ambient><diffuse>0.1 0.8 0.2 0.6</diffuse></material></visual>
      </link>
    </model>

    <model name="goal_zone">
      <static>true</static>
      <pose>4.0 4.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 0.6</ambient><diffuse>0.9 0.1 0.1 0.6</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
