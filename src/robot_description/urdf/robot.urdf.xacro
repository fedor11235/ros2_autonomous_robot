<?xml version="1.0"?>
<!--
  Custom differential-drive robot for autonomous navigation in Gazebo.
  Kinematics: 2 driven wheels + 1 passive caster (classic diff-drive).
  Sensors:  2D lidar, RGB-D depth camera (Orbbec Astra class), GPS.
  The file is split so that pure-kinematics (links/joints) live here and
  all Gazebo-specific tags (plugins, sensors, friction) live in
  robot.gazebo.xacro, which is included at the bottom.
-->
<robot name="autobot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ============================ Parameters ============================ -->
  <xacro:property name="base_length" value="0.40"/>
  <xacro:property name="base_width"  value="0.30"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_mass"   value="6.0"/>

  <xacro:property name="wheel_radius"    value="0.065"/>
  <xacro:property name="wheel_width"     value="0.040"/>
  <xacro:property name="wheel_mass"      value="0.5"/>
  <xacro:property name="wheel_separation" value="0.34"/>   <!-- centre-to-centre -->
  <xacro:property name="wheel_xoff"      value="0.10"/>     <!-- forward of base centre -->
  <xacro:property name="wheel_zoff"      value="0.02"/>     <!-- drop below base centre -->

  <xacro:property name="caster_radius" value="0.045"/>
  <xacro:property name="caster_xoff"   value="0.15"/>

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- ============================ Macros ============================ -->
  <!-- Solid cylinder inertia, axis along local Y (wheel spin axis) -->
  <xacro:macro name="cylinder_inertia_y" params="m r h">
    <inertia
      ixx="${(1/12)*m*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
      iyy="${0.5*m*r*r}"
      iyz="0.0"
      izz="${(1/12)*m*(3*r*r + h*h)}"/>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia
      ixx="${(1/12)*m*(y*y + z*z)}" ixy="0.0" ixz="0.0"
      iyy="${(1/12)*m*(x*x + z*z)}" iyz="0.0"
      izz="${(1/12)*m*(x*x + y*y)}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia
      ixx="${0.4*m*r*r}" ixy="0.0" ixz="0.0"
      iyy="${0.4*m*r*r}" iyz="0.0"
      izz="${0.4*m*r*r}"/>
  </xacro:macro>

  <!-- ============================ base_footprint ============================ -->
  <!-- Ground-projected frame used by navigation / Nav2 conventions -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + wheel_zoff}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ base_link ============================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.15 0.35 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </inertial>
  </link>

  <!-- ============================ Wheels ============================ -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_xoff} ${y_reflect * wheel_separation/2} ${-wheel_zoff}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_reflect="1"/>
  <xacro:wheel prefix="right" y_reflect="-1"/>

  <!-- ============================ Caster ============================ -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="caster_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <xacro:sphere_inertia m="0.2" r="${caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="${-caster_xoff} 0 ${-(wheel_radius + wheel_zoff - caster_radius)}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ 2D Lidar ============================ -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar_dark"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <xacro:cylinder_inertia_y m="0.15" r="0.035" h="0.04"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="${base_length/2 - 0.05} 0 ${base_height/2 + 0.03}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ Depth camera (Orbbec Astra class) ============================ -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.16 0.04"/></geometry>
      <material name="camera_white"><color rgba="0.9 0.9 0.9 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.03 0.16 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <xacro:box_inertia m="0.2" x="0.03" y="0.16" z="0.04"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${base_length/2} 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame: REP-103, z-forward / x-right / y-down, used by image data -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ============================ GPS ============================ -->
  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="0.02" length="0.03"/></geometry>
      <material name="gps_green"><color rgba="0.1 0.6 0.2 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <xacro:cylinder_inertia_y m="0.05" r="0.02" h="0.03"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="gps_link"/>
    <origin xyz="${-base_length/2 + 0.05} 0 ${base_height/2 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ Gazebo plugins & sensors ============================ -->
  <xacro:include filename="$(find robot_description)/urdf/robot.gazebo.xacro"/>

</robot>
