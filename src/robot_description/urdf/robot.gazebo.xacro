<?xml version="1.0"?>
<!--
  Gazebo-specific description for Ignition/Gazebo Fortress (gz-sim 6).
  System plugins (diff drive, joint states) + sensors (gpu_lidar, rgbd_camera,
  navsat). Sensor data is published on gz topics and bridged to ROS 2 by
  ros_gz_bridge (see robot_gazebo/config/bridge.yaml):
    * diff drive  -> /odom (+ /tf), subscribes /cmd_vel
    * gpu_lidar   -> /scan
    * rgbd_camera -> /camera/image, /camera/depth_image, /camera/points
    * navsat      -> /gps/fix
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ============================ Materials / friction ============================ -->
  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1e5</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1e5</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="front_caster_link">
    <!-- Frictionless ball caster so the diff drive can turn freely -->
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="rear_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ============================ Diff drive + odometry + joint states ============================ -->
  <gazebo>
    <!-- Actuation: maps /cmd_vel to wheel velocities.
         left/right joints are intentionally crossed: with the wheel axes as
         defined, this makes a positive angular.z command rotate the robot
         left (CCW) to match the odometry/controller convention. -->
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>right_wheel_joint</left_joint>
      <right_joint>left_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.065</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ============================ 2D Lidar (gpu_lidar) ============================ -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ============================ Depth camera (rgbd_camera) ============================ -->
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <topic>camera</topic>
      <ignition_frame_id>camera_optical_link</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.047198</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ============================ GPS (navsat) ============================ -->
  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <topic>gps/fix</topic>
      <ignition_frame_id>gps_link</ignition_frame_id>
      <update_rate>5</update_rate>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

</robot>
